{
  "appId": "com.ewwon.app",
  "appName": "Ewwon",
  "webDir": "../dist",
  "backgroundColor": "#08080a",
  "server": { "androidScheme": "https" },
  "android": { "backgroundColor": "#08080a", "allowMixedContent": false, "webContentsDebuggingEnabled": false },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 1500, "launchAutoHide": true, "backgroundColor": "#08080a", "showSpinner": false, "androidScaleType": "CENTER_CROP", "splashFullScreen": true, "splashImmersive": true },
    "StatusBar": { "style": "DARK", "backgroundColor": "#08080a", "overlaysWebView": false },
    "PushNotifications": { "presentationOptions": ["badge", "sound", "alert"] },
    "LocalNotifications": { "smallIcon": "ic_stat_ewwon", "iconColor": "#FFFFFF", "sound": "ewwon_msg.wav" }
  }
}
