# Copie este arquivo para .env.local no ambiente externo.
# Não cole chaves secretas no código.

# URL pública do backend compatível com Supabase/PostgREST/Auth/Storage.
VITE_SUPABASE_URL=https://seu-backend-externo.exemplo.com

# Chave pública/anon do backend externo.
VITE_SUPABASE_PUBLISHABLE_KEY=sua_chave_publica_anon

# Usado apenas em scripts de migração, nunca no frontend.
TARGET_DATABASE_URL=postgresql://usuario:senha@host:5432/banco
